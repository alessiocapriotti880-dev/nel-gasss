<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Analisi del sistema (sola lettura): raccolta su Windows (cartella Windows/) e valutazione pura
    (Evaluation/) di servizi, avvio, attività, driver, alimentazione, timer, interrupt, impostazioni
    di gioco, sicurezza e modifiche lasciate da altri ottimizzatori.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PcOptimizer.Analysis</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcOptimizer.Core\PcOptimizer.Core.csproj" />
    <ProjectReference Include="..\PcOptimizer.Hardware\PcOptimizer.Hardware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" LogicalName="Data.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcOptimizer.Analysis.Tests" />
  </ItemGroup>

</Project>
