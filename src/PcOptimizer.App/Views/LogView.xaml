<UserControl x:Class="PcOptimizer.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="0,0,12,12">
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Aggiorna" Command="{Binding RefreshCommand}" />
                    <Button Content="Apri la cartella dei dati" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
                <TextBlock Text="Registro" Style="{StaticResource H1}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="{Binding DataFolder, StringFormat=Ogni modifica è registrata con il valore originale. Backup .reg ripristinabili anche senza l’app: {0}}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Giornale delle modifiche" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Journal}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                                            <Run Text="{Binding State, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Changes}" Style="{StaticResource Muted}" FontFamily="Consolas" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Attività recenti" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding State.Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Log dell'applicazione" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
