<UserControl x:Class="PcOptimizer.App.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="0,0,12,12">
            <TextBlock Text="Overclock e undervolt" Style="{StaticResource H1}" />
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Warn}">
                <TextBlock Text="{Binding SafetyText}" />
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Checklist del BIOS" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Bios}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceRaised}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <WrapPanel>
                                            <Border Style="{StaticResource Badge}" Background="{Binding Level, Converter={StaticResource LevelToBrush}}">
                                                <TextBlock Text="{Binding State}" Foreground="#FF0B1220" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Risk}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding MenuPath, StringFormat=Dove: {0}}" Margin="0,4,0,0"
                                                   Visibility="{Binding MenuPath, Converter={StaticResource NullToVisibility}}" />
                                        <TextBlock Text="{Binding Recommendation, StringFormat=→ {0}}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Verify, StringFormat=Verifica: {0}}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                   Visibility="{Binding Verify, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Test di stabilità" Style="{StaticResource H2}" />
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding TestKinds}" SelectedItem="{Binding TestKind}" />
                        <TextBlock Text="Minuti" VerticalAlignment="Center" Margin="0,0,6,8" />
                        <TextBox Text="{Binding TestMinutes, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                        <Button Content="Avvia il test" Style="{StaticResource PrimaryButton}" Command="{Binding RunTestCommand}" IsEnabled="{Binding State.IsIdle}" />
                        <Button Content="Interrompi" Command="{Binding CancelTestCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding TestResult}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Methods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding Blocked, StringFormat=Non disponibile: {0}}" Foreground="{StaticResource Warn}"
                                           Visibility="{Binding Blocked, Converter={StaticResource NullToVisibility}}" />
                                <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Where, StringFormat=Dove: {0}}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding StepsText}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding LimitsText}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Method.Warning}" Foreground="{StaticResource Warn}" Margin="0,0,0,6"
                                               Visibility="{Binding Method.Warning, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text="{Binding NextText}" FontWeight="SemiBold" Margin="0,4,0,8" />
                                    <WrapPanel>
                                        <Button Content="Ho impostato il valore: avvia il test" Style="{StaticResource PrimaryButton}" Command="{Binding TestCurrentValueCommand}" />
                                        <Button Content="Segna come instabile" Command="{Binding MarkUnstableCommand}" />
                                        <Button Content="Ricomincia" Command="{Binding RestartCommand}" />
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding History}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
