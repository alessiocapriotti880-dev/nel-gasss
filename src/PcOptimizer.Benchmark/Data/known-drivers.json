{
  // Driver del kernel che compaiono spesso fra i DPC/ISR lunghi (stile LatencyMon).
  // "patterns": nome del file; un '*' finale indica un prefisso. "hint": cosa fare se è il driver peggiore.
  "entries": [
    { "patterns": ["nvlddmkm.sys"], "name": "Driver video NVIDIA", "category": "Gpu",
      "hint": "Aggiorna il driver NVIDIA; se i picchi restano, reinstallalo pulito con DDU in modalità provvisoria. Picchi isolati durante cambi di modalità video sono normali." },
    { "patterns": ["amdkmdag.sys", "atikmdag.sys", "amdkmdap.sys"], "name": "Driver video AMD", "category": "Gpu",
      "hint": "Aggiorna il driver AMD Adrenalin (eventualmente reinstallazione pulita con DDU)." },
    { "patterns": ["igdkmd64.sys", "igdkmdn64.sys", "igdkmdnd64.sys"], "name": "Driver video Intel", "category": "Gpu",
      "hint": "Aggiorna il driver grafico Intel dal sito Intel o del produttore del PC." },
    { "patterns": ["dxgkrnl.sys", "dxgmms2.sys"], "name": "Kernel grafico DirectX", "category": "Gpu",
      "hint": "Di solito riflette il driver video: aggiornalo e verifica overlay o software di registrazione attivi." },
    { "patterns": ["nvhda64v.sys"], "name": "Audio HDMI NVIDIA", "category": "Audio",
      "hint": "Se non usi l'audio via HDMI/DisplayPort, puoi disattivare il dispositivo audio NVIDIA in Gestione dispositivi." },
    { "patterns": ["atihdwt6.sys", "amdhdaudbus.sys"], "name": "Audio HDMI AMD", "category": "Audio",
      "hint": "Se non usi l'audio via HDMI/DisplayPort, puoi disattivare il dispositivo audio AMD in Gestione dispositivi." },
    { "patterns": ["hdaudbus.sys", "hdaudio.sys", "portcls.sys", "ks.sys"], "name": "Sottosistema audio di Windows", "category": "Audio",
      "hint": "Aggiorna il driver audio della scheda madre (Realtek o altro) dal sito del produttore della scheda madre." },
    { "patterns": ["rtkvhd64.sys", "rtkvhd*"], "name": "Audio Realtek", "category": "Audio",
      "hint": "Aggiorna il driver Realtek dal sito della scheda madre; disattiva gli 'effetti audio' e i software di miglioramento audio." },
    { "patterns": ["nahimicservice*", "nahimic*", "a-volute*"], "name": "Nahimic (A-Volute)", "category": "Audio",
      "hint": "Nahimic è noto per causare latenze e conflitti: valuta di disinstallarlo." },
    { "patterns": ["ndis.sys"], "name": "Rete (NDIS)", "category": "Network",
      "hint": "Riflette il driver della scheda di rete: aggiornalo dal produttore del chip (Intel, Realtek, Killer). Su Wi-Fi spesso migliora usando il cavo." },
    { "patterns": ["tcpip.sys", "netio.sys", "afd.sys"], "name": "Stack di rete di Windows", "category": "Network",
      "hint": "Traffico di rete intenso durante la misura (download, aggiornamenti, sincronizzazione cloud) o driver di rete: ripeti la misura a rete ferma." },
    { "patterns": ["netwtw*.sys", "netwbw*.sys", "netwlv64.sys"], "name": "Wi-Fi Intel", "category": "Network",
      "hint": "I driver Wi-Fi generano spesso DPC lunghi durante la scansione delle reti: aggiorna il driver o usa il cavo Ethernet per giocare." },
    { "patterns": ["rtwlane*.sys", "rtwlanu*.sys", "rtwlan*.sys", "rtl8*.sys"], "name": "Wi-Fi Realtek", "category": "Network",
      "hint": "Aggiorna il driver Wi-Fi Realtek o usa il cavo Ethernet per giocare." },
    { "patterns": ["athw*.sys", "qcamain*.sys", "athwnx.sys"], "name": "Wi-Fi Qualcomm Atheros/Killer", "category": "Network",
      "hint": "Aggiorna il driver Wi-Fi o usa il cavo Ethernet per giocare." },
    { "patterns": ["mtkwl*.sys", "mtkwecx.sys"], "name": "Wi-Fi MediaTek", "category": "Network",
      "hint": "Aggiorna il driver Wi-Fi MediaTek/AMD RZ6xx o usa il cavo Ethernet per giocare." },
    { "patterns": ["rt640x64.sys", "rt68*.sys", "rtux64w10.sys", "rtcx21x64.sys"], "name": "Ethernet Realtek", "category": "Network",
      "hint": "Aggiorna il driver Realtek dal sito Realtek; nelle proprietà avanzate verifica 'Ethernet a basso consumo' e il risparmio energetico." },
    { "patterns": ["e1d*.sys", "e1r*.sys", "e1i*.sys", "e2f*.sys"], "name": "Ethernet Intel", "category": "Network",
      "hint": "Aggiorna il driver Intel Ethernet; su I225-V/I226-V verifica le revisioni con problemi noti e il firmware." },
    { "patterns": ["kfeco*.sys", "killer*.sys", "kndx*.sys"], "name": "Killer Networking", "category": "Network",
      "hint": "Il servizio di prioritizzazione Killer può aggiungere latenza: valuta il solo driver senza Killer Control Center." },
    { "patterns": ["cfosspeed*.sys"], "name": "cFosSpeed", "category": "Network",
      "hint": "Il traffic shaping di cFosSpeed (spesso preinstallato su schede madri) aggiunge lavoro a ogni pacchetto: valuta di disinstallarlo." },
    { "patterns": ["storport.sys", "stornvme.sys", "storahci.sys", "ataport.sys", "iastor*.sys", "iastora*.sys", "amdsata.sys", "amdxata.sys", "rcraid.sys"], "name": "Archiviazione (dischi)", "category": "Storage",
      "hint": "Attività del disco durante la misura (indicizzazione, antivirus, aggiornamenti) o driver del controller: ripeti la misura a riposo e aggiorna il driver del chipset/RST." },
    { "patterns": ["nvme*.sys", "secnvme.sys", "samsungnvme*.sys"], "name": "Driver NVMe del produttore", "category": "Storage",
      "hint": "Aggiorna il driver o il firmware dell'SSD con lo strumento del produttore." },
    { "patterns": ["usbxhci.sys", "ucx01000.sys", "usbport.sys", "usbhub3.sys", "usbehci.sys", "hidusb.sys", "hidclass.sys"], "name": "USB", "category": "Usb",
      "hint": "Una periferica USB genera molto lavoro: prova a scollegare i dispositivi non necessari (hub, webcam, controller RGB) e ripeti la misura." },
    { "patterns": ["acpi.sys"], "name": "ACPI (gestione energia del firmware)", "category": "Platform",
      "hint": "Picchi ACPI dipendono spesso dal BIOS o dalla gestione batteria sui portatili: aggiorna il BIOS e, sui portatili, il driver della batteria/ACPI del produttore." },
    { "patterns": ["intelppm.sys", "amdppm.sys", "processr.sys"], "name": "Gestione energetica della CPU", "category": "Platform",
      "hint": "Transizioni degli stati di risparmio della CPU: verifica il piano energetico; la disattivazione dei C-state dal BIOS va misurata, aumenta consumi e temperature." },
    { "patterns": ["wdf01000.sys", "wudfrd.sys"], "name": "Framework dei driver di Windows", "category": "Platform",
      "hint": "È l'infrastruttura usata da molti driver: il colpevole è un altro dispositivo. Disattiva temporaneamente i dispositivi non usati in Gestione dispositivi per isolarlo." },
    { "patterns": ["ntoskrnl.exe", "hal.dll"], "name": "Kernel di Windows", "category": "Platform",
      "hint": "Tempo nel kernel stesso (timer, scheduler): di solito dipende da altro carico o dalla gestione energetica, non va corretto direttamente." },
    { "patterns": ["wdfilter.sys", "wdboot.sys", "wdnisdrv.sys"], "name": "Microsoft Defender", "category": "Security",
      "hint": "Scansione in corso durante la misura: ripeti più tardi. Non disattivare Defender per guadagnare latenza." },
    { "patterns": ["vgk.sys", "easyanticheat*.sys", "bedaisy.sys", "faceit*.sys"], "name": "Anti-cheat", "category": "Security",
      "hint": "Driver anti-cheat: non va toccato. L'app non interagisce mai con gli anti-cheat." },
    { "patterns": ["winring0*.sys", "gdrv.sys", "asrdrv10*.sys", "inpout*.sys", "rtcore64.sys"], "name": "Driver di monitoraggio/RGB", "category": "Software",
      "hint": "Driver usati da programmi di monitoraggio e RGB: chiudi quei programmi durante il gioco o disinstallali se non servono." },
    { "patterns": ["vmbus.sys", "storvsc.sys", "netvsc*.sys", "vmswitch.sys"], "name": "Hyper-V / macchina virtuale", "category": "Platform",
      "hint": "Presente in macchina virtuale o con funzioni di virtualizzazione attive." }
  ]
}
