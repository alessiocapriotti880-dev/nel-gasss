<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Benchmark: misure di latenza (DPC/ISR via ETW, risveglio del timer), frame time (PresentMon),
    rete (ping/jitter), avvio, uso CPU e sensori. Calcolo statistico e confronto prima/dopo puri
    (Statistics/, Comparison/), misure su Windows nella cartella Windows/.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PcOptimizer.Benchmark</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcOptimizer.Core\PcOptimizer.Core.csproj" />
    <ProjectReference Include="..\PcOptimizer.Hardware\PcOptimizer.Hardware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" LogicalName="Data.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcOptimizer.Benchmark.Tests" />
  </ItemGroup>

</Project>
