<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core: contratti, giornale delle modifiche, rollback, backup e log.
    Target net8.0 (non -windows) così i test girano ovunque; il codice che usa
    API Windows è marcato [SupportedOSPlatform("windows")].
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PcOptimizer.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcOptimizer.Core.Tests" />
  </ItemGroup>

</Project>
