<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hardware: rilevamento (solo Windows, cartella Windows/) e valutazione (pura, testabile ovunque):
    identificazione di CPU/GPU, stima XMP, canali RAM, classificazione in fascia e osservazioni.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PcOptimizer.Hardware</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcOptimizer.Core\PcOptimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tabelle dati: incorporate nell'assembly, sovrascrivibili da file esterni senza ricompilare. -->
    <EmbeddedResource Include="Data\*.json" LogicalName="Data.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcOptimizer.Hardware.Tests" />
  </ItemGroup>

</Project>
