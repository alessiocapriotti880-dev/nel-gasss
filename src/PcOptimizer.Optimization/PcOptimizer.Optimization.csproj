  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PcOptimizer.Optimization</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcOptimizer.Core\PcOptimizer.Core.csproj" />
    <ProjectReference Include="..\PcOptimizer.Benchmark\PcOptimizer.Benchmark.csproj" />
    <ProjectReference Include="..\PcOptimizer.Tweaks\PcOptimizer.Tweaks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcOptimizer.Optimization.Tests" />
  </ItemGroup>

</Project>
